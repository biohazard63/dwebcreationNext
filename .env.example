# ---------- Envoi des emails du formulaire ----------
# Option 1 (recommandée sans nom de domaine) : Gmail
# Créez un « mot de passe d'application » : https://myaccount.google.com/apppasswords
# (la validation en deux étapes doit être activée sur le compte Google)
SMTP_USER=quentindevaulx63@gmail.com
SMTP_PASS=
# Facultatif : autre serveur SMTP (par défaut smtp.gmail.com, port 465)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Option 2 : Resend (https://resend.com), utile avec un nom de domaine vérifié
# Sans domaine vérifié, seuls les emails vers l'adresse du compte Resend partent
# (pas d'email de confirmation au visiteur).
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL="D Web Créations <contact@votre-domaine.fr>"

# Adresse qui reçoit les demandes (par défaut : l'email de lib/site.ts)
CONTACT_TO_EMAIL=quentindevaulx63@gmail.com

# ---------- Site ----------
# URL publique du site (sitemap / robots.txt / balises SEO)
SITE_URL=https://dwebcreation.com

# Code de vérification Google Search Console (optionnel)
GOOGLE_SITE_VERIFICATION=
